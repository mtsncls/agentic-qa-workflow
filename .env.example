# ========= Aplicación bajo prueba =========
APP_BASE_URL=https://www.saucedemo.com

# ========= Anthropic / Claude Code =========
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Alias de modelo aceptado por Claude Code: sonnet | opus | haiku | <model-id>
CLAUDE_MODEL=sonnet

# ========= Jira Cloud (REST API v3) =========
# Ej: https://tu-empresa.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=tu-email@empresa.com
# Token de API: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Proyecto donde se crean bugs / se buscan historias
JIRA_PROJECT_KEY=QA

# Campo de criterios de aceptación:
#   "description" | customfield_XXXXX
JIRA_AC_FIELD=description

# Tipo de link entre bug e historia (Relates | Blocks | ...)
JIRA_LINK_TYPE=Blocks
# Transición opcional cuando TODO pasa (nombre parcial ej: "Done")
JIRA_TRANSITION_PASS=
# Transición opcional cuando se crea un bug (ej: "In Progress")
JIRA_TRANSITION_BUG=

# ========= Motor de decisiones =========
# Confianza mínima del agente analista para abrir bug automáticamente (0..1)
BUG_CONFIDENCE_THRESHOLD=0.7
# Reintentos automáticos antes de analizar la falla (0..3)
MAX_RETRIES=1

# ========= Rutas =========
ARTIFACTS_DIR=artifacts

# ========= Modos de prueba (útiles sin credenciales) =========
# MOCK_JIRA=1      -> usa un Jira simulado en memoria
# DRY_RUN=1        -> agentes con respuestas deterministas (sin llamar a Claude)
MOCK_JIRA=0
DRY_RUN=0

# Simula una regresión de producto para demostrar creación de bugs
DEMO_FAIL=0
