# ========= Application under test =========
APP_BASE_URL=https://www.saucedemo.com

# ========= Anthropic / Claude Code =========
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model alias accepted by Claude Code: sonnet | opus | haiku | <model-id>
CLAUDE_MODEL=sonnet

# ========= Jira Cloud (REST API v3) =========
# E.g. https://your-company.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=you@company.com
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Project where bugs are created / stories are looked up
JIRA_PROJECT_KEY=QA

# Acceptance criteria field:
#   "description" | customfield_XXXXX
JIRA_AC_FIELD=description

# Link type between bug and story (Relates | Blocks | ...)
JIRA_LINK_TYPE=Blocks
# Optional transition when EVERYTHING passes (partial name, e.g. "Done")
JIRA_TRANSITION_PASS=
# Optional transition when a bug is created (e.g. "In Progress")
JIRA_TRANSITION_BUG=

# ========= Decision engine =========
# Minimum analyst confidence to open a bug automatically (0..1)
BUG_CONFIDENCE_THRESHOLD=0.7
# Automatic retries before analyzing the failure (0..3)
MAX_RETRIES=1

# ========= Paths =========
ARTIFACTS_DIR=artifacts

# ========= Trial modes (useful without credentials) =========
# MOCK_JIRA=1      -> uses an in-memory simulated Jira
# DRY_RUN=1        -> agents answer deterministically (no LLM calls)
MOCK_JIRA=0
DRY_RUN=0

# Simulates a product regression to demonstrate bug creation
DEMO_FAIL=0
