# ========= Application under test =========
APP_BASE_URL=https://www.saucedemo.com

# ========= LLM provider (OpenAI-compatible: OpenRouter, OpenAI, Ollama, ...) =========
# Get a free key at https://openrouter.ai/keys (free models like deepseek/deepseek-chat:free)
LLM_API_KEY=
# OpenAI-compatible base URL. OpenRouter by default; use http://localhost:11434/v1 for Ollama.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Any OpenAI-compatible model id. Defaults to a free model.
LLM_MODEL=qwen/qwen3-coder:free
# Legacy alias kept for backwards compatibility with Claude Code tooling:
CLAUDE_MODEL=sonnet

# ========= Jira Cloud (REST API v3) =========
# E.g. https://your-company.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=you@company.com
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Project where bugs are created / stories are looked up
JIRA_PROJECT_KEY=QA

# Acceptance criteria field:
#   "description" | customfield_XXXXX
JIRA_AC_FIELD=description

# Link type between bug and story (Relates | Blocks | ...)
JIRA_LINK_TYPE=Blocks
# Optional transition when EVERYTHING passes (partial name, e.g. "Done")
JIRA_TRANSITION_PASS=
# Optional transition when a bug is created (e.g. "In Progress")
JIRA_TRANSITION_BUG=

# ========= Decision engine =========
# Minimum analyst confidence to open a bug automatically (0..1)
BUG_CONFIDENCE_THRESHOLD=0.7
# Automatic retries before analyzing the failure (0..3)
MAX_RETRIES=1

# ========= Paths =========
ARTIFACTS_DIR=artifacts

# ========= uReport (test reporting server) =========
# Optional. When both UREPORT_URL and UREPORT_API_TOKEN are set, every pipeline
# run is also pushed to uReport as a build (with the agent's verdict attached).
# Start a local instance with: docker compose --profile ureport up --build
# Then create a token in the UI (avatar → Edit Profile → API Token).
UREPORT_URL=
UREPORT_API_TOKEN=
# Product lane and build type in uReport.
UREPORT_PRODUCT=agentic-qa-workflow
UREPORT_TYPE=E2E
UREPORT_TEAM=QA
# Optional environment name (dev / staging / prod).
UREPORT_STAGE=
# Failure screenshots are the riskiest payload to send out: they can show real
# user data. Keep them off unless uReport runs on infrastructure you control.
UREPORT_ATTACH_SCREENSHOTS=0
# Replace the local repository path with "<repo>" in the error messages and
# stack traces before they leave the machine.
UREPORT_REDACT_PATHS=1
# Total budget for one push, in milliseconds. The push never fails the
# pipeline, but it must not be able to stall it either.
UREPORT_DEADLINE_MS=60000

# ========= uReport server (docker compose --profile ureport) =========
# Password of the seeded admin account. The container refuses to start while
# this is empty or "changeme". It is only applied on the first startup, when
# the database is still empty.
UREPORT_ADMIN_EMAIL=admin@example.com
UREPORT_ADMIN_PASSWORD=

# ========= Trial modes (useful without credentials) =========
# MOCK_JIRA=1      -> uses an in-memory simulated Jira
# DRY_RUN=1        -> agents answer deterministically (no LLM calls)
MOCK_JIRA=0
DRY_RUN=0

# Simulates a product regression to demonstrate bug creation
DEMO_FAIL=0
